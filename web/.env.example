# Base URL of the SorobanPulse API (no trailing slash).
# In dev the Vite proxy rewrites /api/* so this can stay blank,
# in production point it at your deployment.
VITE_API_BASE_URL=http://localhost:3000

# API key for the X-Api-Key header.
# Never commit a real key; use .env.local for development secrets.
VITE_API_KEY=
